---
interface Props {
  item: { date: string; label: string; name: string; text: string; url: string; prefix?: string; highlight?: string; ending?: string };
}
const { item } = Astro.props;
---
<li class="news-item">
  <time datetime={item.date}>{item.label}</time>
  <p>
    {item.prefix && <>{item.prefix} </>}
    <a href={item.url} target="_blank" rel="noopener noreferrer">{item.name}</a>
    {item.text && <> {item.text}</>}
    {item.highlight && <> <strong class="news-distinction">{item.highlight}</strong></>}
    {item.ending}
  </p>
</li>
