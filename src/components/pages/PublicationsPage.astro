---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Publication from '../Publication.astro';
import publications from '../../data/publications.json';
import { copy, type Locale } from '../../lib/i18n';
interface Props { lang: Locale }
const { lang } = Astro.props;
const t = copy[lang];
const papers = [...publications.papers].sort((a,b) => b.year - a.year);
const sections = [
  { id: 'conference-papers', title: t.conferencePapers, papers: papers.filter(paper => paper.type === 'conference') },
  { id: 'technical-reports', title: t.technicalReports, papers: papers.filter(paper => paper.type === 'preprint') },
].filter(section => section.papers.length);
---
<BaseLayout lang={lang} title={t.publications} active="publications" description={t.publicationsDescription}>
  <header class="page-heading"><h1>{t.publications}</h1></header>
  {sections.map(section => <section class="publication-section" aria-labelledby={section.id}>
    <div class="section-heading"><h2 id={section.id}>{section.title}</h2></div>
    <div class="publication-list">{section.papers.map(paper => <Publication paper={paper} lang={lang} headingLevel={3} showStatus={false} />)}</div>
  </section>)}
</BaseLayout>
