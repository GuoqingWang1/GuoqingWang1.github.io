---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { publishedPosts, postPath, formatPostDate } from '../../lib/posts';
import { copy, localizedPath, type Locale } from '../../lib/i18n';
interface Props { lang: Locale }
const { lang } = Astro.props;
const t = copy[lang];
const posts = await publishedPosts(lang);
const otherLang: Locale = lang === 'en' ? 'zh-CN' : 'en';
const otherLanguagePosts = posts.length === 0 ? await publishedPosts(otherLang) : [];
const categories = ['technical', 'reflection'] as const;
---
<BaseLayout lang={lang} title={t.blog} active="blog" description={t.blogDescription}>
  <header class="page-heading blog-heading"><h1>{t.blog}</h1></header>
  <section aria-label={t.blog}>
    {posts.length > 0 ? <>
      <div class="blog-layout">
        <div class="category-legend" role="group" aria-label={lang === 'zh-CN' ? '文章分类' : 'Article category'}>
          {categories.map(category => <button class={`category-button ${category}`} type="button" data-category={category} aria-pressed="false">
            <span class="category-mark" aria-hidden="true" />{t[category]}
          </button>)}
        </div>
        <div class="blog-list" id="post-list">
          {posts.map(post => <a class={`blog-entry ${post.data.category}`} data-post-category={post.data.category} data-description={post.data.description} href={postPath(post)}>
            <time datetime={post.data.pubDate.toISOString()}>{formatPostDate(post.data.pubDate)}</time>
            <span class="post-title" lang={post.data.lang}>{post.data.title}</span>
          </a>)}
          <p class="filter-empty" id="filtered-empty" hidden>{t.noCategoryPosts}</p>
        </div>
      </div>
      <div class="branch-overlay" aria-hidden="true"><svg><path d="" /></svg></div>
      <p class="hover-note" aria-hidden="true"></p>
      <footer class="blog-footer"><a href={localizedPath('/rss.xml', lang)}>{t.rss}</a></footer>
    </> : <div class="blog-empty empty-state">
      <p>{otherLanguagePosts.length > 0 ? t.otherLanguagePosts : t.noPosts}</p>
      {otherLanguagePosts.length > 0 && <a class="other-blog-link" href={localizedPath('/blog/', otherLang)} lang={otherLang}>{t.otherBlog}<span aria-hidden="true"> →</span></a>}
    </div>}
  </section>
</BaseLayout>
<script>
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-category]'));
  const rows = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-post-category]'));
  const note = document.querySelector<HTMLElement>('.hover-note');
  const overlay = document.querySelector<HTMLElement>('.branch-overlay');
  const curve = overlay?.querySelector<SVGPathElement>('path');
  const list = document.getElementById('post-list');
  let selected: string | null = null;
  let currentRow: HTMLAnchorElement | null = null;
  const hideNote = () => { note?.classList.remove('visible'); overlay?.classList.remove('visible'); currentRow = null; };
  buttons.forEach(button => button.addEventListener('click', () => {
    selected = selected === button.dataset.category ? null : button.dataset.category!;
    hideNote();
    buttons.forEach(b => b.setAttribute('aria-pressed', String(b.dataset.category === selected)));
    let visible = 0;
    rows.forEach(row => { row.hidden = selected !== null && row.dataset.postCategory !== selected; if (!row.hidden) visible++; });
    const empty = document.getElementById('filtered-empty');
    if (empty) empty.hidden = visible > 0;
  }));
  function showNote(row: HTMLAnchorElement) {
    if (!note || !overlay || !curve || !list || !matchMedia('(min-width: 1000px) and (hover: hover)').matches) return;
    const left = Math.max(list.getBoundingClientRect().right + 36, innerWidth * 0.63);
    const available = Math.min(320, innerWidth - left - 32);
    if (available < 200) { hideNote(); return; }
    currentRow = row;
    note.style.left = `${left}px`; note.style.width = `${available}px`;
    note.textContent = row.dataset.description || '';
    note.classList.add('visible');
    const title = row.querySelector('.post-title')!.getBoundingClientRect();
    const target = note.getBoundingClientRect();
    const start = { x: title.right + 10, y: title.top + title.height / 2 };
    const end = { x: target.left - 16, y: target.top + target.height / 2 };
    const control = (end.x - start.x) * 0.45;
    curve.setAttribute('d', `M${start.x},${start.y} C${start.x + control},${start.y} ${end.x - control},${end.y} ${end.x},${end.y}`);
    const length = curve.getTotalLength();
    curve.style.transition = 'none'; curve.style.strokeDasharray = `${length}`; curve.style.strokeDashoffset = `${length}`;
    curve.getBoundingClientRect();
    curve.style.removeProperty('transition'); curve.style.strokeDashoffset = '0';
    overlay.classList.add('visible');
  }
  rows.forEach(row => {
    row.addEventListener('mouseenter', () => showNote(row));
    row.addEventListener('focus', () => showNote(row));
    row.addEventListener('mouseleave', hideNote);
    row.addEventListener('blur', hideNote);
  });
  window.addEventListener('resize', hideNote);
  window.addEventListener('scroll', () => { if (currentRow) hideNote(); }, { passive: true });
</script>
