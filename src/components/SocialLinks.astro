---
import github from '../assets/github.svg?raw';
import scholar from '../assets/googlescholar.svg?raw';
import { profile } from '../data/profile';
---
<div class="social-links" aria-label="Academic profiles">
  <a href={profile.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub" title="GitHub"><span aria-hidden="true" set:html={github} /></a>
  <a href={profile.scholar} target="_blank" rel="noopener noreferrer" aria-label="Google Scholar" title="Google Scholar"><span aria-hidden="true" set:html={scholar} /></a>
</div>
