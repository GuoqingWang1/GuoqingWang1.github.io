---
import github from '../assets/github.svg?raw';
import { profile } from '../data/profile';
import { copy, type Locale } from '../lib/i18n';
interface Props {
  lang?: Locale;
  compact?: boolean;
  headingLevel?: 2 | 3;
  showStatus?: boolean;
  paper: { id: string; title: string; url: string; venue: string; year: number; type: string; authors: string[]; code?: string }
}
const { paper, lang = 'zh-CN', compact = false, headingLevel = 2, showStatus = true } = Astro.props;
const t = copy[lang];
const Title = headingLevel === 3 ? 'h3' : 'h2';
---
<article class:list={['publication', { 'publication-compact': compact }]} id={paper.id}>
  <div class="pub-content">
    <Title class="pub-title" lang="en"><a href={paper.url} target="_blank" rel="noopener noreferrer">{paper.title}</a></Title>
    {!compact && <p class="pub-authors" lang="en">{paper.authors.map((author, index) => <>{author === profile.name ? <strong>{author}</strong> : author}{index < paper.authors.length - 1 ? ', ' : ''}</>)}</p>}
    <div class="pub-details">
      <p class="pub-meta"><span lang="en">{paper.venue} {paper.year}</span>{showStatus && paper.type === 'preprint' && <span class="pub-status">{t.technicalReport}</span>}</p>
      {!compact && paper.code && <a class="code-link" href={paper.code} target="_blank" rel="noopener noreferrer" aria-label={lang === 'zh-CN' ? `${paper.title} 的代码` : `Code for ${paper.title}`} title={t.code}><span aria-hidden="true" set:html={github} /><span>{t.code}</span></a>}
    </div>
  </div>
</article>
