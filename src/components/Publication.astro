---
import github from '../assets/github.svg?raw';
import { profile } from '../data/profile';
import { copy, type Locale } from '../lib/i18n';
interface Props {
  lang?: Locale;
  compact?: boolean;
  showAuthors?: boolean;
  headingLevel?: 2 | 3;
  showAuthorship?: boolean;
  paper: { id: string; title: string; url: string; venue: string; year: number; type: string; authors: string[]; code?: string; authorship?: string; distinction?: string }
}
const { paper, lang = 'en', compact = false, showAuthors = !compact, headingLevel = 2, showAuthorship = false } = Astro.props;
const t = copy[lang];
const Title = headingLevel === 3 ? 'h3' : 'h2';
const authorship = paper.authorship === 'co-first' ? t.coFirstAuthor : paper.authorship === 'core-contributor' ? t.coreContributor : null;
const venue = paper.type === 'technical-report' ? t.technicalReport : paper.type === 'preprint' ? t.preprint : paper.venue;
---
<article class:list={['publication', { 'publication-compact': compact, compact }]} id={paper.id}>
    <div class="pub-title-line">
      <Title class="pub-title" lang="en"><a href={paper.url} target="_blank" rel="noopener noreferrer">{paper.title}</a></Title>
      <span class="pub-inline-meta">
        <span class="venue" lang="en">[{venue} {paper.year}{paper.distinction && <> · {paper.distinction}</>}]</span>
        {paper.code && <a class="code-link" href={paper.code} target="_blank" rel="noopener noreferrer" aria-label={lang === 'zh-CN' ? `${paper.title} 的代码` : `Code for ${paper.title}`} title={t.code}><span aria-hidden="true" set:html={github} /><span>{t.code}</span></a>}
      </span>
    </div>
    {showAuthors && <p class="pub-authors" lang="en">{paper.authors.map((author, index) => <>{author === profile.name ? <><strong>{author}</strong>{showAuthorship && authorship && <span class="pub-authorship"> ({authorship})</span>}</> : author}{index < paper.authors.length - 1 ? ', ' : ''}</>)}</p>}
</article>
