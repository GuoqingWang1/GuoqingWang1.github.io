---
import '../styles/global.css';
import logo from '../../public/logo.svg?raw';
import { profile } from '../data/profile';
interface Props {
  title?: string;
  description?: string;
  active?: 'about' | 'blog';
  lang?: 'en' | 'zh-CN';
  article?: boolean;
  published?: Date;
  updated?: Date;
  noindex?: boolean;
}
const { title = profile.name, description = profile.description, active = 'about', lang = 'en', article = false, published, updated, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const pageTitle = title === profile.name ? title : `${title} — ${profile.name}`;
const schema = article ? {
  '@context': 'https://schema.org', '@type': 'BlogPosting', headline: title, description,
  author: { '@type': 'Person', name: profile.name, url: Astro.site },
  datePublished: published?.toISOString(), dateModified: (updated || published)?.toISOString(),
  mainEntityOfPage: canonical.href,
} : {
  '@context': 'https://schema.org', '@type': 'Person', name: profile.name,
  url: Astro.site, sameAs: [profile.scholar, profile.github],
};
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#ffffff" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/logo.svg" />
    <link rel="alternate" type="application/rss+xml" title={`${profile.name} — Blog`} href="/rss.xml" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:site_name" content={profile.name} />
    <meta name="twitter:card" content="summary" />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="site">
      <header class="header">
        <a class="name" href="/" aria-label="Guoqing Wang, home">
          <span class="brand-mark" aria-hidden="true" set:html={logo} /><span>{profile.name}</span>
        </a>
        <nav aria-label="Main navigation">
          <a href="/" aria-current={active === 'about' ? 'page' : undefined}>About</a>
          <a href="/blog/" aria-current={active === 'blog' ? 'page' : undefined}>Blog</a>
        </nav>
      </header>
      <main id="main" tabindex="-1"><slot /></main>
    </div>
  </body>
</html>
