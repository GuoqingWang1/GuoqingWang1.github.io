---
import '@fontsource/spectral/latin-400.css';
import '@fontsource/spectral/latin-400-italic.css';
import '@fontsource/spectral/latin-500.css';
import '@fontsource/spectral/latin-600.css';
import '../styles/global.css';
import logo from '../../public/logo.svg?raw';
import SocialLinks from '../components/SocialLinks.astro';
import BackgroundParticles from '../components/BackgroundParticles.astro';
import { profile } from '../data/profile';
import { copy, localizedPath, type Locale } from '../lib/i18n';
interface Props {
  title?: string;
  description?: string;
  active?: 'about' | 'publications' | 'blog';
  lang?: Locale;
  article?: boolean;
  published?: Date;
  updated?: Date;
  noindex?: boolean;
}
const { lang = 'en', active = 'about', article = false, published, updated, noindex = false } = Astro.props;
const t = copy[lang];
const navigation = copy.en;
const { title = profile.name, description = t.description } = Astro.props;
const otherLang: Locale = lang === 'zh-CN' ? 'en' : 'zh-CN';
const blogScope = active === 'blog' && !noindex;
const equivalent = blogScope && !article;
const switchPath = localizedPath('/blog/', otherLang);
const canonical = new URL(Astro.url.pathname, Astro.site);
const pageTitle = title === profile.name ? title : `${title} — ${profile.name}`;
const pageKind = noindex ? 'plain' : article ? 'article' : active === 'about' ? 'home' : active;
const schema = article ? {
  '@context': 'https://schema.org', '@type': 'BlogPosting', headline: title, description,
  author: { '@type': 'Person', name: profile.name, url: Astro.site },
  datePublished: published?.toISOString(), dateModified: (updated || published)?.toISOString(),
  mainEntityOfPage: canonical.href,
  inLanguage: lang,
} : {
  '@context': 'https://schema.org', '@type': 'Person', name: profile.name,
  url: Astro.site, sameAs: [profile.scholar, profile.github],
};
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#121212" media="(prefers-color-scheme: dark)" />
    <link rel="canonical" href={canonical} />
    {equivalent && <>
      <link rel="alternate" hreflang="zh-CN" href={new URL(localizedPath(Astro.url.pathname, 'zh-CN'), Astro.site)} />
      <link rel="alternate" hreflang="en" href={new URL(localizedPath(Astro.url.pathname, 'en'), Astro.site)} />
      <link rel="alternate" hreflang="x-default" href={new URL(localizedPath('/blog/', 'en'), Astro.site)} />
    </>}
    <link rel="icon" type="image/svg+xml" href="/logo.svg" />
    <link rel="alternate" type="application/rss+xml" title={`${profile.name} — ${t.blog}`} href={localizedPath('/rss.xml', lang)} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:locale" content={lang === 'zh-CN' ? 'zh_CN' : 'en_US'} />
    <meta name="twitter:card" content="summary" />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />
  </head>
  <body data-page={pageKind}>
    <a class="skip-link" href="#main">{t.skip}</a>
    {pageKind === 'home' && <BackgroundParticles lang={lang} />}
    <header class="site-header" lang="en" data-blog={blogScope || undefined}>
      <a class="site-name" href="/" aria-label={`${profile.name}, ${navigation.about}`}>
        <span class="brand-mark" aria-hidden="true" set:html={logo} /><span>{profile.name}</span>
      </a>
      <button class="menu-toggle" type="button" aria-label={navigation.openNavigation} data-label-open={navigation.openNavigation} data-label-close={navigation.closeNavigation} aria-expanded="false" aria-controls="main-navigation"><span></span><span></span><span></span></button>
      <nav class="navigation" id="main-navigation" aria-label={navigation.navigation}>
        <div class="nav-links">
          <a href="/" aria-current={active === 'about' ? 'page' : undefined}>{navigation.about}</a>
          <a href="/#news">News</a>
          <a href="/publications/" aria-current={active === 'publications' ? 'page' : undefined}>{navigation.publications}</a>
          <a href={localizedPath('/blog/', lang)} aria-current={active === 'blog' ? 'page' : undefined}>{navigation.blog}</a>
        </div>
        <SocialLinks lang="en" />
      </nav>
      {blogScope && <a class="language-switch" href={switchPath} lang={otherLang} hreflang={otherLang} data-equivalent={equivalent || undefined} aria-label={article ? t.otherBlog : t.switchTitle} title={article ? t.otherBlog : t.switchTitle}>{article ? t.otherBlog : t.switchLabel}</a>}
    </header>
    <main id="main" class:list={['page', `${pageKind}-page`]} tabindex="-1"><slot /></main>
    <script is:inline>
      const header = document.querySelector('.site-header');
      const toggle = document.querySelector('.menu-toggle');
      if (header && toggle) {
        document.documentElement.classList.add('nav-enhanced');
        const closeMenu = () => { header.dataset.open = 'false'; toggle.setAttribute('aria-expanded', 'false'); toggle.setAttribute('aria-label', toggle.dataset.labelOpen); };
        toggle.addEventListener('click', () => {
          const open = toggle.getAttribute('aria-expanded') !== 'true';
          header.dataset.open = String(open); toggle.setAttribute('aria-expanded', String(open));
          toggle.setAttribute('aria-label', open ? toggle.dataset.labelClose : toggle.dataset.labelOpen);
        });
        document.addEventListener('keydown', event => { if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') { closeMenu(); toggle.focus(); } });
        document.addEventListener('click', event => { if (!header.contains(event.target)) closeMenu(); });
        window.matchMedia('(max-width: 768px)').addEventListener('change', closeMenu);
        header.querySelectorAll('.nav-links a').forEach(link => link.addEventListener('click', closeMenu));
      }
      const languageLink = document.querySelector('.language-switch[data-equivalent]');
      if (languageLink) {
        const preserveAnchor = () => { languageLink.hash = location.hash; };
        preserveAnchor();
        window.addEventListener('hashchange', preserveAnchor);
      }
    </script>
  </body>
</html>
