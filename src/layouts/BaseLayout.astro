---
import '@fontsource/spectral/latin-400.css';
import '@fontsource/spectral/latin-400-italic.css';
import '@fontsource/spectral/latin-500.css';
import '@fontsource/spectral/latin-600.css';
import '../styles/global.css';
import SocialLinks from '../components/SocialLinks.astro';
import { profile } from '../data/profile';
import shareImages from '../data/share-images.json';
import { copy, localizedPath, type Locale } from '../lib/i18n';
interface Props {
  title?: string;
  description?: string;
  active?: 'about' | 'publications' | 'blog';
  lang?: Locale;
  article?: boolean;
  articleTranslations?: Partial<Record<Locale, string>>;
  articleAnchors?: Record<string, string>;
  published?: Date;
  updated?: Date;
  noindex?: boolean;
}
const { lang = 'en', active = 'about', article = false, articleTranslations = {}, articleAnchors = {}, published, updated, noindex = false } = Astro.props;
const t = copy[lang];
const navigation = t;
const { title = profile.name, description = t.description } = Astro.props;
const equivalent = !noindex && !article;
const otherLang: Locale = lang === 'en' ? 'zh-CN' : 'en';
const switchPath = article ? articleTranslations[otherLang] : localizedPath(Astro.url.pathname, otherLang);
const translationLinks = article ? Object.entries(articleTranslations) : [];
const canonical = new URL(Astro.url.pathname, Astro.site);
const pageTitle = title === profile.name ? title : `${title} — ${profile.name}`;
const shareImage = shareImages[lang];
const shareImageUrl = new URL(shareImage.path, Astro.site);
const pageKind = noindex ? 'plain' : article ? 'article' : active === 'about' ? 'home' : active;
const IdentityHeading = pageKind === 'home' ? 'h1' : 'div';
const schema = article ? {
  '@context': 'https://schema.org', '@type': 'BlogPosting', headline: title, description,
  author: { '@type': 'Person', name: profile.name, url: Astro.site },
  datePublished: published?.toISOString(), dateModified: (updated || published)?.toISOString(),
  mainEntityOfPage: canonical.href,
  inLanguage: lang,
} : {
  '@context': 'https://schema.org', '@type': 'Person', name: profile.name,
  url: Astro.site, sameAs: [profile.scholar, profile.github],
};
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#ffffff" />
    <meta name="color-scheme" content="light" />
    <link rel="canonical" href={canonical} />
    {equivalent && <>
      <link rel="alternate" hreflang="zh-CN" href={new URL(localizedPath(Astro.url.pathname, 'zh-CN'), Astro.site)} />
      <link rel="alternate" hreflang="en" href={new URL(localizedPath(Astro.url.pathname, 'en'), Astro.site)} />
      <link rel="alternate" hreflang="x-default" href={new URL(localizedPath(Astro.url.pathname, 'en'), Astro.site)} />
    </>}
    {article && translationLinks.length > 1 && <>
      {translationLinks.map(([locale, route]) => <link rel="alternate" hreflang={locale} href={new URL(route!, Astro.site)} />)}
      <link rel="alternate" hreflang="x-default" href={new URL(articleTranslations.en!, Astro.site)} />
    </>}
    <link rel="icon" type="image/svg+xml" href="/logo.svg" />
    <link rel="alternate" type="application/rss+xml" title={`${profile.name} — ${t.blog}`} href={localizedPath('/rss.xml', lang)} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:locale" content={lang === 'zh-CN' ? 'zh_CN' : 'en_US'} />
    <meta property="og:image" content={shareImageUrl} />
    <meta property="og:image:secure_url" content={shareImageUrl} />
    <meta property="og:image:type" content={shareImage.type} />
    <meta property="og:image:width" content={shareImage.width} />
    <meta property="og:image:height" content={shareImage.height} />
    <meta property="og:image:alt" content={shareImage.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImageUrl} />
    <meta name="twitter:image:alt" content={shareImage.alt} />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />
  </head>
  <body class="theme-e" data-page={pageKind}>
    <a class="skip-link" href="#main">{t.skip}</a>
    <div class="site-shell">
      <header class="site-header" lang={lang}>
        <div class="site-identity">
          <IdentityHeading class="site-identity-name">
            <a class="site-name brand" href={localizedPath('/', lang)} aria-label={`${profile.name}, ${navigation.about}`}>
              <span class="brand-name" lang="en">{profile.name}</span>
            </a>
          </IdentityHeading>
          <p class="brand-affiliation">{navigation.affiliation}</p>
        </div>
        <nav class="site-nav" id="main-navigation" aria-label={navigation.navigation}>
          <a href={localizedPath('/', lang)} aria-current={active === 'about' ? 'page' : undefined}>{navigation.about}</a>
          <a href={localizedPath('/publications/', lang)} aria-current={active === 'publications' ? 'page' : undefined}>{navigation.publications}</a>
          <a href={localizedPath('/blog/', lang)} aria-current={active === 'blog' ? 'page' : undefined}>{navigation.blog}</a>
        </nav>
        <div class="header-actions">
          <SocialLinks lang={lang} />
          {!noindex && switchPath && <a class="language-switch header-language-switch" href={switchPath}
            lang={otherLang} hreflang={otherLang} data-equivalent={equivalent || undefined}
            data-article-translation={article || undefined} data-anchor-map={article ? JSON.stringify(articleAnchors) : undefined}
            title={article ? t.switchArticleTitle : t.switchTitle}
            aria-label={article ? t.switchArticleTitle : t.switchTitle}>{t.switchLabel}</a>}
        </div>
      </header>
      <main id="main" class:list={['page', `${pageKind}-page`]} tabindex="-1"><slot /></main>
    </div>
    <script is:inline>
      const languageLink = document.querySelector('.language-switch[data-equivalent], .language-switch[data-article-translation]');
      if (languageLink) {
        const anchorMap = languageLink.dataset.anchorMap ? JSON.parse(languageLink.dataset.anchorMap) : null;
        const preserveAnchor = () => {
          if (!anchorMap) { languageLink.hash = location.hash; return; }
          let key;
          try { key = decodeURIComponent(location.hash.slice(1)); } catch { key = ''; }
          languageLink.hash = Object.prototype.hasOwnProperty.call(anchorMap, key) ? anchorMap[key] : '';
        };
        preserveAnchor();
        window.addEventListener('hashchange', preserveAnchor);
      }
    </script>
  </body>
</html>
